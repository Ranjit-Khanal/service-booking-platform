NODE_ENV=development
PORT=3000
INSTANCE_ID=api-local

# When using docker compose from the host, use remapped ports:
# Postgres 5433, Redis 6380, RabbitMQ 5673 (see docker-compose.yml)
DATABASE_URL=postgres://slotbook:slotbook@localhost:5433/slotbook
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=slotbook:

RABBITMQ_URL=amqp://slotbook:slotbook@localhost:5673
BOOKING_EVENTS_EXCHANGE=booking.events
NOTIFICATION_QUEUE=notifications
NOTIFICATION_DLQ=notifications.dlq

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

PAYMENT_PROVIDER=mock
PAYMENT_TIMEOUT_MS=3000
PAYMENT_MAX_RETRIES=3

IDEMPOTENCY_TTL_SECONDS=86400
LOG_LEVEL=info

# Failure simulation (ops/admin)
FAIL_PAYMENT=false
FAIL_REDIS=false
FAIL_DATABASE=false
FAIL_BROKER_PUBLISH=false
PAYMENT_LATENCY_MS=0
