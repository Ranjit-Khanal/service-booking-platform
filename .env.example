# Root .env for `docker compose`. Copy to `.env` and change every value marked CHANGE.
# All values here are placeholders for local use — never commit a real .env.
#
# For running the backend directly on the host (npm run dev), use backend/.env.example instead.

# ---------------------------------------------------------------- DATABASE
POSTGRES_USER=slotbook
POSTGRES_PASSWORD=slotbook                 # CHANGE for anything beyond your laptop
POSTGRES_DB=slotbook
DB_POOL_MAX=10

# ---------------------------------------------------------------- REDIS
REDIS_KEY_PREFIX=slotbook:

# ---------------------------------------------------------------- MESSAGE_BROKER
RABBITMQ_USER=slotbook
RABBITMQ_PASSWORD=slotbook                 # CHANGE for anything beyond your laptop

# ---------------------------------------------------------------- AUTH
# api_key: every /api route except /api/health needs `Authorization: Bearer <key>` (or X-API-Key).
# none:    no authentication (local experiments only).
AUTH_MODE=api_key
# Comma-separated; one key per integrating application. Generate with: openssl rand -hex 32
API_KEYS=dev-local-key-change-me           # CHANGE
# Enables /api/admin/* (failure injection, cache flush) when set; min 16 chars. Empty = disabled.
ADMIN_API_KEY=

# ---------------------------------------------------------------- SERVER
LOG_LEVEL=info
CORS_ORIGINS=*                             # e.g. https://app.example.com,https://admin.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120                         # per client IP per window

# ---------------------------------------------------------------- BOOKING / PAYMENT
# mock is the only functional provider; stripe/esewa are stubs that always succeed.
PAYMENT_PROVIDER=mock
PAYMENT_TIMEOUT_MS=3000
PAYMENT_MAX_RETRIES=3
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------- HOST PORTS
# Infrastructure ports bind to 127.0.0.1 only.
API_HOST_PORT=8080
DEMO_CLIENT_HOST_PORT=5173
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5673
RABBITMQ_UI_HOST_PORT=15673

# ---------------------------------------------------------------- DEMO CLIENT (build time)
# Baked into the demo's public JavaScript — demo use only. Must be one of API_KEYS.
DEMO_CLIENT_API_KEY=dev-local-key-change-me
# Set to ADMIN_API_KEY to make the demo's Ops page work.
DEMO_CLIENT_ADMIN_API_KEY=
